<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="anchorPane"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ClientMVC.ClientView.Chat.ChatJFXController">

    <children>
        <!-- Text field -->
        <TextField fx:id="messageField"
                   layoutX="74.0" layoutY="361.0"
                   prefHeight="25.0" prefWidth="452.0" />

        <!-- Extra button (not linked in controller) -->
        <Button layoutX="14.0" layoutY="361.0"
                mnemonicParsing="false" text="Button" />

        <!-- Send button -->
        <Button fx:id="sendButton"
                layoutX="534.0" layoutY="361.0"
                mnemonicParsing="false" text="Send" />

        <!-- Label -->
        <Label fx:id="label"
               layoutX="-90.0" layoutY="131.0" text="Label" />

        <!-- Rectangle -->
        <Rectangle fx:id="rectangle"
                   arcHeight="5.0" arcWidth="5.0"
                   fill="#dddddd" height="53.0"
                   layoutY="-1.0" stroke="BLACK"
                   strokeType="INSIDE" strokeWidth="0.0"
                   width="600.0" />

        <!-- Home button -->
        <Button fx:id="home"
                layoutX="14.0" layoutY="13.0"
                mnemonicParsing="false" text="Home" />

        <!-- ScrollPane with VBox -->
        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    layoutY="52.0" prefHeight="297.0" prefWidth="600.0">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0"
                            prefHeight="295.0" prefWidth="599.0">
                    <children>
                        <VBox fx:id="messagesArea"
                              layoutX="-1.0" layoutY="-2.0"
                              prefHeight="308.0" prefWidth="588.0" />
                    </children>
                </AnchorPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
