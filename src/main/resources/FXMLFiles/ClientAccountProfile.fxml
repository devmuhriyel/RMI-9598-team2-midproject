      </Label>
      <TextField id="ipAddressInput" fx:id="accountUsernameTextField" layoutX="139.0" layoutY="82.0" prefHeight="38.0" prefWidth="220.0" promptText="Username" stylesheets="@../style.css" />
      <Label fx:id="oldPasswordLabel" contentDisplay="CENTER" layoutX="69.0" layoutY="158.0" prefHeight="20.0" prefWidth="100.0" text="Old Password" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="Gill Sans MT" size="12.0" />
         </font>
      </Label>
      <Label fx:id="newPasswordLabel" contentDisplay="CENTER" layoutX="69.0" layoutY="193.0" prefHeight="20.0" prefWidth="100.0" text="New Password" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="Gill Sans MT" size="12.0" />
         </font>
      </Label>
      <PasswordField fx:id="oldPasswordTextField" layoutX="174.0" layoutY="156.0" promptText="Old Password" />
