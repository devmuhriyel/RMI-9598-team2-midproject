      <Label fx:id="confirmPassswordTextField" contentDisplay="CENTER" layoutX="69.0" layoutY="228.0" prefHeight="20.0" prefWidth="100.0" text="Confirm Password" textAlignment="CENTER" textFill="WHITE">
