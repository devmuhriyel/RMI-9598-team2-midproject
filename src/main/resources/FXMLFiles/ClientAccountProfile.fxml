<AnchorPane fx:id="rightFrame" prefHeight="365.0" prefWidth="390.0" style="-fx-background-color: #202020;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
