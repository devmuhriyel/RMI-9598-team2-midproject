      </Label>
      <PasswordField fx:id="confirmPasswordTextField" layoutX="174.0" layoutY="226.0" promptText="Confirm Password" />
      <Label fx:id="profileLabel" alignment="CENTER" contentDisplay="TOP" prefHeight="38.0" prefWidth="390.0" text="PROFILE" textFill="WHITE">
         <font>
            <Font name="Gill Sans MT" size="30.0" />
