<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #010104;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientMVC.ClientView.Chat.ChatJFXController">

    <children>
        <!-- Text field -->
        <TextField fx:id="messageField" layoutX="74.0" layoutY="361.0" prefHeight="25.0" prefWidth="452.0" style="-fx-background-color: #4a4a4a; -fx-text-fill: white;" />

        <!-- Extra button (not linked in controller) -->
        <Button layoutX="14.0" layoutY="361.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="50.0" style="-fx-background-color: dedcff;" text="File" textAlignment="CENTER" />

        <!-- Send button -->
        <Button fx:id="sendButton" layoutX="534.0" layoutY="361.0" mnemonicParsing="false" style="-fx-background-color: dedcff;" text="Send" />

        <!-- Label -->
        <Label fx:id="label" layoutX="281.0" layoutY="30.0" text="Person" textFill="WHITE" />

        <!-- Home button -->
        <Button fx:id="home" layoutX="14.0" layoutY="13.0" mnemonicParsing="false" style="-fx-background-color: dedcff;" text="Back" />

        <!-- ScrollPane with VBox -->
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" layoutY="52.0" pannable="true" prefHeight="297.0" prefWidth="600.0" vbarPolicy="ALWAYS">
         <content>
            <VBox fx:id="messagesArea" prefHeight="296.0" prefWidth="586.0" />
         </content>
        </ScrollPane>
    </children>
</AnchorPane>
