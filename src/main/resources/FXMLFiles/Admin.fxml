<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientMVC.ClientView.Admin.AdminPageJFXController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="44.0" prefWidth="780.0" spacing="10" BorderPane.alignment="CENTER">
            <children>
                <TabPane fx:id="tabPane">
                    <tabs>
                        <Tab closable="false" text="USERS" />
                        <Tab closable="false" text="Group Chats" />
                    </tabs>
                </TabPane>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search..." />
                <Button fx:id="searchButton" text="🔍" />
            </children>
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </HBox>
    </top>
    <center>
        <StackPane>
            <children>
                <!-- USERS PANE -->
                <BorderPane fx:id="usersPane">
                    <center>
                        <TableView fx:id="tableView" prefHeight="250" prefWidth="600">
                            <columns>
                                <TableColumn fx:id="ownerCol" prefWidth="400" text="Username" />
                                <TableColumn fx:id="groupChatCol" prefWidth="400" text="Password" />
                            </columns>
                        </TableView>
                    </center>
                    <bottom>
                        <VBox spacing="10" BorderPane.alignment="CENTER">
                            <children>
                                <HBox spacing="61">
                                    <Label text="Username:" />
                                    <TextField fx:id="usernameField" promptText="Enter username" />
                                </HBox>
                                <HBox spacing="10">
                                    <Label text="Change Password:" />
                                    <PasswordField fx:id="newPasswordField" promptText="Enter new password" />
                                </HBox>
                                <HBox spacing="10">
                                    <Label text="Change Password:" />
                                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" />
                                </HBox>
                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="deleteButton" text="Delete" />
                                    <Button fx:id="editButton" text="Edit" />
                                </HBox>
                            </children>
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                        </VBox>
                    </bottom>
                </BorderPane>

                <!-- GROUPS PANE -->
                <BorderPane fx:id="groupsPane" visible="false" managed="false">
                    <center>
                        <TableView prefHeight="250" prefWidth="600">
                            <columns>
                                <TableColumn prefWidth="400" text="Owner" />
                                <TableColumn prefWidth="400" text="Group" />
                            </columns>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox alignment="CENTER_RIGHT" spacing="10" BorderPane.alignment="CENTER">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="groupDeleteButton" text="Delete" />
                            <Button fx:id="groupEditButton" text="Edit" />
                        </HBox>
                    </bottom>
                </BorderPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
