<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="adminRoot" prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="AdminMVC.AdminView.Admin.AdminPageJFXController">

    <children>

        <!-- Left Sidebar -->
        <VBox fx:id="menuFrame" prefHeight="600.0" prefWidth="180.0" spacing="15"
              style="-fx-background-color: #181818;" alignment="TOP_CENTER">
            <children>
                <ImageView fitHeight="120.0" fitWidth="150.0" preserveRatio="true">
                    <VBox.margin>
                        <Insets top="20" bottom="20"/>
                    </VBox.margin>
                </ImageView>

                <Button fx:id="usersButton" text="Users"
                        style="-fx-background-color: #8700b1; -fx-text-fill: white;"
                        prefWidth="120" prefHeight="35"/>

                <Button fx:id="groupsButton" text="Groups"
                        style="-fx-background-color: #8700b1; -fx-text-fill: white;"
                        prefWidth="120" prefHeight="35"/>
            </children>
        </VBox>

        <!-- Main Content -->
        <BorderPane layoutX="180.0" prefHeight="600.0" prefWidth="620.0"
                    style="-fx-background-color: #202020;">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Admin Dashboard" textFill="white">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchField" promptText="Search..."
                                   style="-fx-background-radius: 20; -fx-background-color: #2a2a2a; -fx-text-fill: white;"
                                   prefWidth="200"/>
                        <Button fx:id="searchButton" text="🔍"
                                style="-fx-background-color: #8700b1; -fx-text-fill: white;"
                                prefWidth="40"/>
                    </children>
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10"/>
                    </padding>
                </HBox>
            </top>

            <center>
                <TableView fx:id="tableView" prefHeight="400" prefWidth="600"
                           style="-fx-background-color: #2a2a2a; -fx-text-fill: white;">
                    <columns>
                        <TableColumn fx:id="usernameCol" prefWidth="310" text="Username"/>
                        <TableColumn fx:id="passwordCol" prefWidth="310" text="Password"/>
                    </columns>
                </TableView>
            </center>

            <bottom>
                <VBox spacing="10" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="deleteButton" text="Delete"
                                    style="-fx-background-color: #b10000; -fx-text-fill: white;"/>
                            <Button fx:id="editButton" text="Edit"
                                    style="-fx-background-color: #0087b1; -fx-text-fill: white;"/>
                        </HBox>
                    </children>
                    <padding>
                        <Insets top="20" bottom="10" left="20" right="20"/>
                    </padding>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
