<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminMVC.AdminView.Admin.AdminPageJFXController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Admin Panel - Groups Management" />

            <!-- Navigation and Actions Bar -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button fx:id="backToUsersButton" text="← Back to Users" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="createGroupButton" text="Create Group" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button fx:id="refreshButton" text="🔄 Refresh" />
                <Button fx:id="viewActiveUsersButton" text="Active Users" />
                <Button fx:id="viewCommunityMessagesButton" text="Community Messages" />
            </HBox>

            <!-- Search Bar -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Search Groups:" />
                <TextField fx:id="groupSearchField" promptText="Enter group name..." prefWidth="200.0" />
                <Button fx:id="groupSearchButton" text="Search" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <!-- Groups Table -->
            <TableView fx:id="groupsTableView" prefHeight="400.0">
                <columns>
                    <TableColumn fx:id="groupCol" prefWidth="200.0" text="Group Name" />
                    <TableColumn fx:id="groupOwnerCol" prefWidth="200.0" text="Owner/Creator" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Action Buttons -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button fx:id="groupEditButton" text="Edit Group" disable="true" />
                <Button fx:id="groupDeleteButton" text="Delete Group" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="viewStatsButton" text="View Statistics" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="Admin Panel - Manage user groups and permissions" style="-fx-font-style: italic;" />
        </HBox>
    </bottom>
</BorderPane>