<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="44.0" prefWidth="780.0" spacing="10" BorderPane.alignment="CENTER">
            <children>
                <TabPane>
                    <tabs>
                        <Tab closable="false" text="USERS" />
                        <Tab closable="false" text="Group Chats" />
                    </tabs>
                </TabPane>
                <Region HBox.hgrow="ALWAYS" />
                <TextField promptText="Search..." />
                <Button text="🔍" />
            </children>
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </HBox>
    </top>
    <center>
        <TableView prefHeight="250" prefWidth="600">
            <columns>
                <TableColumn prefWidth="265" text="Owner" />
                <TableColumn prefWidth="265" text="Group Chat" />
                <TableColumn prefWidth="265" text="Configuration" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <children>
                <HBox spacing="61">
                    <Label text="Username:" />
                    <TextField promptText="Enter username" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Change Password:" />
                    <PasswordField promptText="Enter new password" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Change Password:" />
                    <PasswordField promptText="Confirm new password" />
                </HBox>
            </children>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
