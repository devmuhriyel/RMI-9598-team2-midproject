<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ClientMVC.HomepageController" prefWidth="400" prefHeight="300">
    <children>
        <VBox alignment="CENTER" spacing="20" layoutX="50" layoutY="50" prefWidth="300">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Button text="Start Chat" onAction="#handleStartChatButton" prefWidth="150" />
            <Button text="Logout" onAction="#handleLogoutButton" prefWidth="150" />
        </VBox>
    </children>
</AnchorPane>