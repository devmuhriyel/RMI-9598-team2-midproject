<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="groupsRoot" prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ClientMVC.ClientView.Admin.AdminPageJFXController">

    <children>

        <!-- Left Sidebar -->
        <VBox fx:id="menuFrame" prefHeight="600.0" prefWidth="180.0" spacing="15"
              style="-fx-background-color: #181818;" alignment="TOP_CENTER">
            <children>
                <ImageView fitHeight="120.0" fitWidth="150.0" preserveRatio="true">
                    <VBox.margin>
                        <Insets top="20" bottom="20"/>
                    </VBox.margin>
                </ImageView>

                <Button fx:id="backToUsersButton" text="← Users"
                        style="-fx-background-color: #8700b1; -fx-text-fill: white;"
                        prefWidth="120" prefHeight="35"/>
            </children>
        </VBox>

        <!-- Main Content -->
        <BorderPane layoutX="180.0" prefHeight="600.0" prefWidth="620.0"
                    style="-fx-background-color: #202020;">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Groups Management" textFill="white">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="groupSearchField" promptText="Search..."
                                   style="-fx-background-radius: 20; -fx-background-color: #2a2a2a; -fx-text-fill: white;"
                                   prefWidth="200"/>
                        <Button fx:id="groupSearchButton" text="🔍"
                                style="-fx-background-color: #8700b1; -fx-text-fill: white;"
                                prefWidth="40"/>
                    </children>
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10"/>
                    </padding>
                </HBox>
            </top>

            <center>
                <TableView fx:id="groupsTableView" prefHeight="400" prefWidth="600"
                           style="-fx-background-color: #2a2a2a; -fx-text-fill: white;">
                    <columns>
                        <TableColumn fx:id="ownerCol" prefWidth="310" text="Owner"/>
                        <TableColumn fx:id="groupCol" prefWidth="310" text="Group"/>
                    </columns>
                </TableView>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT" spacing="10" BorderPane.alignment="CENTER">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="groupDeleteButton" text="Delete"
                            style="-fx-background-color: #b10000; -fx-text-fill: white;"/>
                    <Button fx:id="groupEditButton" text="Edit"
                            style="-fx-background-color: #0087b1; -fx-text-fill: white;"/>
                </HBox>
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20"/>
                </padding>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
