<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="accountRoot" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #202020;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientMVC.ClientView.Account.AccountJFXController">
   <children>
      <AnchorPane fx:id="leftFrame" prefHeight="403.0" prefWidth="210.0" style="-fx-background-color: #FFFFFF;">
         <children>
            <VBox fx:id="menuFrame" alignment="CENTER" prefHeight="403.0" prefWidth="210.0" spacing="15.0" style="-fx-background-color: #FFFFFF;">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../Images/variety-logo/black_on_trans.png" />
                     </image>
                     <VBox.margin>
                        <Insets bottom="15.0" top="-30.0" />
                     </VBox.margin>
                  </ImageView>
                  <Button fx:id="profileAccountButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#showProfile" prefHeight="25.0" prefWidth="70.0" style="-fx-background-color: #8700b1;" text="Profile">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="requestsAccountButton" layoutX="1000.0" mnemonicParsing="false" onAction="#showRequests" prefWidth="70.0" style="-fx-background-color: #8700b1;" text="Requests">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="settingsAccountButton" mnemonicParsing="false" onAction="#showSettings" prefWidth="70.0" style="-fx-background-color: #8700b1;" text="Settings">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="logoutAccountButton" mnemonicParsing="false" prefWidth="70.0" style="-fx-background-color: #8700b1;" text="Logout" />
               </children>
               <padding>
                  <Insets left="30.0" right="30.0" />
               </padding>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
         </children>
      </AnchorPane>
      <AnchorPane fx:id="rightMainFrame" layoutX="210.0" prefHeight="400.0" prefWidth="390.0" style="-fx-background-color: #202020;">
         <children>
            <AnchorPane fx:id="rightFrame" layoutY="36.0" prefHeight="367.0" prefWidth="390.0" style="-fx-background-color: #202020;" />
            <Button fx:id="closeButton" cacheShape="false" focusTraversable="false" layoutX="358.0" layoutY="6.0" minWidth="25.0" prefHeight="30.0" prefWidth="25.0" styleClass="window-control" stylesheets="@../../style.css" text="x">
               <font>
                  <Font size="9.0" />
               </font>
            </Button>
            <Button fx:id="minimizeButton" contentDisplay="CENTER" layoutX="333.0" layoutY="6.0" minWidth="15.0" prefHeight="30.0" prefWidth="25.0" styleClass="window-control" stylesheets="@../../style.css" text="-">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane fx:id="backNavigation" layoutY="36.0" prefHeight="79.0" prefWidth="210.0">
         <children>
            <Button fx:id="sendButton" alignment="CENTER" layoutX="14.0" layoutY="11.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="42.0" style="-fx-background-radius: 100; -fx-background-color: dedcff;" stylesheets="@../../style.css" text="🔙">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane fx:id="titleBar" prefHeight="17.0" prefWidth="600.0" />
   </children>
</AnchorPane>
