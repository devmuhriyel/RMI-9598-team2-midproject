<AnchorPane fx:id="rightFrame" prefHeight="365.0" prefWidth="390.0" style="-fx-background-color: #202020;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="userLabel" contentDisplay="CENTER" layoutX="69.0" layoutY="92.0" prefHeight="18.0" prefWidth="70.0" text="Username" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="Gill Sans MT" size="12.0" />
         </font>
      </Label>
      <TextField id="ipAddressInput" fx:id="accountUsernameTextField" layoutX="139.0" layoutY="82.0" prefHeight="38.0" prefWidth="220.0" promptText="Username" stylesheets="@../style.css" />
      <Label fx:id="oldPasswordTextField" contentDisplay="CENTER" layoutX="69.0" layoutY="158.0" prefHeight="20.0" prefWidth="100.0" text="Old Password" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="Gill Sans MT" size="12.0" />
         </font>
      </Label>
      <Button fx:id="updateButton" alignment="CENTER" layoutX="146.0" layoutY="296.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="98.0" style="-fx-background-color: dedcff;" stylesheets="@../style.css" text="Update Profile">
         <effect>
            <DropShadow>
               <color>
                  <Color red="1.0" green="1.0" blue="1.0" />
               </color>
            </DropShadow>
         </effect>
      </Button>
      <Label fx:id="newPasswordTextField" contentDisplay="CENTER" layoutX="69.0" layoutY="193.0" prefHeight="20.0" prefWidth="100.0" text="New Password" textAlignment="CENTER" textFill="WHITE">
